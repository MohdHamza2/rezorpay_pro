# =========================
# Environment
# =========================
ENVIRONMENT=development

# =========================
# Database
# =========================
DATABASE_URL=postgresql+asyncpg://postgres:hamza@localhost:5432/invoicesaas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=hamza
POSTGRES_DB=invoicesaas

# =========================
# Redis
# =========================
REDIS_URL=redis://localhost:6379/0

# =========================
# JWT
# =========================
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =========================
# App
# =========================
APP_NAME=InvoiceSaaS
DEBUG=false

# =========================
# Rate Limiting (slowapi)
# =========================
RATE_LIMIT_AUTH=5/minute

# =========================
# Email Engine (Wave 26 — Resend)
# =========================
# COMMS_DRY_RUN=true (default) never dials a provider; simulates SENT rows with simulated=true.
# Set to false + real RESEND_API_KEY to enable live delivery.
COMMS_DRY_RUN=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=InvoiceSaaS <noreply@invoicesaas.example>
RESEND_WEBHOOK_SECRET=

# =========================
# WhatsApp Business Platform (Wave 27 — Meta Cloud API)
# =========================
# One business phone/account per deployment. COMMS_DRY_RUN (above) gates this
# provider too. WHATSAPP_INBOUND_WORKSPACE_ID routes all inbound to one workspace;
# unset => inbound is acknowledged but dropped.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_INBOUND_WORKSPACE_ID=
WHATSAPP_WEBHOOK_MAX_BODY_BYTES=1000000

# =========================
# VAT Compliance Report (Wave 28)
# =========================
# Optional organization TRN stamped into the export manifest. Falls back to
# workspace.trn, then "". Report generation is never blocked by an absent TRN.
VAT_ORG_TRN=

# =========================
# CORS (JSON array; empty [] = no cross-origin access)
# =========================
# CORS_ORIGINS=["http://localhost:5173","https://app.example.com"]
