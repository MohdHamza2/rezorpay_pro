# Normalize line endings: LF in the repo, native on checkout.
* text=auto eol=lf

# Explicit text types (avoid CRLF creeping into scripts/config).
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.ini   text eol=lf
*.cfg   text eol=lf
*.toml  text eol=lf
*.sh    text eol=lf
*.env   text eol=lf
Dockerfile text eol=lf

# Binary assets (never touch).
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
